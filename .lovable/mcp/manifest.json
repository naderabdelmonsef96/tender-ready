{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ujayuhbnnwnwyvqpdire.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "tender-ready",
      "version": "0.1.0",
      "title": "Tender Ready"
    },
    "tools": [
      {
        "name": "list_organizations",
        "title": "List my organizations",
        "description": "List the TenderReady organizations the signed-in user belongs to, with their role in each. Call this first to get an organization id for the other tools.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_tenders",
        "title": "List tenders",
        "description": "List tenders in one of the signed-in user's organizations, newest first. Optionally filter by workflow stage or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Organization id from list_organizations."
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open",
                    "won",
                    "lost",
                    "cancelled",
                    "archived"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional tender status filter; null for all."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum rows to return; null means 25."
            }
          },
          "required": [
            "organizationId",
            "status",
            "limit"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_tender",
        "title": "Get tender",
        "description": "Get one tender by id, including its client, workflow stage, decision state, and the organization's approval stages.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "tenderId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Tender id from list_tenders."
            }
          },
          "required": [
            "tenderId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "List clients",
        "description": "List the client companies recorded in one of the signed-in user's organizations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Organization id from list_organizations."
            }
          },
          "required": [
            "organizationId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_tender",
        "title": "Create tender",
        "description": "Create a draft tender header in one of the signed-in user's organizations. Only proposal engineers and organization admins may create tenders. Does not upload files or invent commercial values.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Organization id from list_organizations."
            },
            "reference": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "description": "Unique tender reference, e.g. TND-2026-014."
            },
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "Tender title in English."
            },
            "titleAr": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tender title in Arabic, or null."
            },
            "clientId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Client id from list_clients, or null if not yet known."
            },
            "projectLocation": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Project location, or null."
            },
            "submissionDeadline": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Submission deadline as YYYY-MM-DD, or null."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Free-text notes, or null."
            }
          },
          "required": [
            "organizationId",
            "reference",
            "title",
            "titleAr",
            "clientId",
            "projectLocation",
            "submissionDeadline",
            "notes"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
